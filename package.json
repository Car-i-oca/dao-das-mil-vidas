{
  "name": "dao-das-mil-vidas",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "sim": "tsx sim/simulate.ts",
    "validate": "tsx sim/validate.ts && tsx sim/validate2.ts",
    "fuzz": "tsx sim/fuzz.ts",
    "endings": "tsx sim/endings.ts",
    "variedade": "tsx sim/variedade.ts",
    "icons": "node scripts/gen-icons.mjs",
    "poder": "tsx sim/poder.ts",
    "galeria": "tsx sim/galeria.ts",
    "impacto": "tsx sim/impacto.ts",
    "e2e:duelo": "node tools/e2e/duelo.mjs",
    "registro": "node tools/registro.mjs",
    "e2e:arte": "node tools/e2e/arte.mjs",
    "e2e:estilo": "node tools/e2e/estilo.mjs",
    "dev:v2": "vite --mode v2 --host",
    "build:v2": "tsc --noEmit && vite build --mode v2 --outDir dist-v2 && node scripts/ajusta-v2.mjs dist-v2",
    "cronica2": "tsx sim/cronica2.ts",
    "coesao": "tsx sim/coesao.ts",
    "e2e:mobile": "node tools/e2e/mobile.mjs",
    "e2e:pixel": "node tools/e2e/pixel.mjs",
    "arte:amostra": "tsx tools/art/amostra.ts",
    "arte": "node tools/arte/exportar.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/node": "^26.6.4",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
